<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Play Protect Hardening: Disallow all cleartext HTTP traffic while permitting
         HTTPS redirects to Hugging Face LFS CDNs (cdn-lfs.hf.co, cas-bridge.xethub.hf.co)
         and user-specified custom HTTPS GGUF model URLs. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
